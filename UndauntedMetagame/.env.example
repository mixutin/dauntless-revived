# Dauntless Revived metagame settings.
# Copy this file to .env in this folder and fill in the empty values.
# npm start and npm run dev read .env (Node refuses to start without it). Variables already set in
# your shell win over the file. Restart the metagame after any change.
#
# The values below are for development on one PC (everything on 127.0.0.1). Lines starting with #
# show the default; leave them out to get it. docs/reference/configuration.md explains every line.
# .env holds secrets: never share it, never commit it (it is git-ignored).

# ------------------------------------------------------------------ listening, logins, database

# TCP port. Required: unset stops the metagame at startup; empty listens on a random port.
PORT=61000
# The one address to listen on. Default 127.0.0.1. Private mode: this PC's Tailscale 100.x address.
# Never 0.0.0.0.
BIND_HOST=127.0.0.1
# production: JSON log lines, no stack traces, AUTH_MODE=NONE ignored. Default: unset (development).
# Use production on anything other people can reach.
# NODE_ENV=production
# APIKEY (account keys) or NONE (development only: anyone logs in as anyone). Required, no default.
AUTH_MODE=APIKEY
# SECRET: never share, never commit. Signs the players' session tokens. Required: unset stops the
# metagame; empty lets it start but every login fails. Generate both lines into .env, unprinted:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('AUTH_SIGNING_PRIVKEY_B64='+Buffer.from(k.privateKey).toString('base64'));console.log('AUTH_SIGNING_PUBKEY_B64='+Buffer.from(k.publicKey).toString('base64'))" | Add-Content .env -Encoding ascii
# (then delete the two empty lines below)
AUTH_SIGNING_PRIVKEY_B64=
# The matching public key (not secret). Required.
AUTH_SIGNING_PUBKEY_B64=
# NONE, INVITECODE or OPEN. Required: unset makes account creation answer 500.
# OPEN lets anyone who reaches the metagame make an account: only while BIND_HOST is 127.0.0.1.
REGISTRATION_MODE=OPEN
# The SQLite database, relative to this folder, forward slashes. Required: unset uses a temporary
# database that is deleted on exit. Never point a development metagame at your players' database.
# *.db files are git-ignored.
DB_FILENAME=undaunted-dev.db
# 1: SQLite WAL journal. Default off (backups copy the database file alone).
# DB_WAL=1

# ------------------------------------------------------------------ matchmaking and the client

# DEPLOYSERVER or DISABLED (no game install: refuse all matchmaking). Required, no default.
MATCHMAKING_MODE=DEPLOYSERVER
# The deploy server, host:port without http://. Required. Keep it on 127.0.0.1.
DEPLOYSERVER_URL=127.0.0.1:61001
# Overall allocation deadline, including the JSON response body. Default 240000 ms.
# Allow enough time for worker startup and configured launch spacing (1000-900000).
# An ambiguous timeout fails this candidate; a new player join can try again.
# MATCHMAKING_DEPLOY_TIMEOUT_MS=240000
# The one region the client pings. Required. Private mode: http://<Tailscale address>:61000/QoS.
# Public mode: http://127.0.0.1:61000/QoS (each player's own launcher relay).
QOS_TARGET_URL=http://127.0.0.1:61000/QoS
# Build id sent to the client. Keep 239827 (the changelist in the 1.4.4 Version.txt). Required.
TARGET_CHANGELIST=239827

# ------------------------------------------------------------------ public mode and game servers

# SECRET: never share, never commit. Turns on public mode (behind UndauntedGateway); must equal the
# gateway's GATEWAY_SECRET. 32-256 printable characters, no spaces. Default: unset (public mode off).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GATEWAY_SECRET=
# Extra addresses allowed to present the game-server key (comma-separated IPs). Default: none,
# only this machine.
# GAMESERVER_ALLOW_FROM=

# ------------------------------------------------------------------ logging

# fatal, error, warn, info, debug, trace or silent. Default info.
# LOG_LEVEL=info
# One line per request (METHOD /path gs=0|1). Default on; 0 turns it off.
# LOG_REQUESTS=0
# 1: append request bodies of unfinished routes to BODY_LOG_FILE (player data), one line per
# request with the reply's status and duration. Default off. Development only; never on a public
# server.
# LOG_BODIES=1
# Where LOG_BODIES writes. Default bodies.log in this folder, which is NOT git-ignored:
# point it outside the repository and never commit it.
# BODY_LOG_FILE=C:/dr/dev/bodies.log
# With LOG_BODIES=1: at most this many lines per method and path in one run. Default 0 (no cap).
# BODY_LOG_PER_PATH=200
#
# The switches below that say on/off take 1, true, on or yes and 0, false, off or no; a value that
# does not parse is logged once and the default is used. The start line "features: ..." shows them.

# ------------------------------------------------------------------ server identity (public)

# Name in the status replies. Default Dauntless Revived (printable ASCII, up to 64 characters).
# SERVER_NAME=Dauntless Revived
# Version in the status replies. Default: the version recorded at build time, then package.json.
# SERVER_VERSION=
# Commit in the status replies. Default: the commit recorded at build time, then unknown.
# GIT_COMMIT=
# Where the running server's source is (the AGPL source offer). Point it at your modified source.
# SOURCE_URL=https://github.com/mixutin/dauntless-revived
# The content server's port, reported to launchers. Default: none (no downloads offered).
# CONTENT_PORT=61002
# /dauntless-status also reports name, version, commit and sourceUrl. Default on; 0 turns it off.
# STATUS_EXTRA=0

# ------------------------------------------------------------------ progression

# Unset, empty or real (the default): every account keeps its own Slayer level, mastery, Hunt Pass
# (Elite for everyone), loadout slots, cooldowns and bounties. stub: upstream's fake max ranks,
# nothing stored. Any other value (off, 0, false...) is logged and treated as real; it used to mean
# stub. Updating a server that already has players? Read docs/setup/upgrading.md first: nothing is
# migrated, and earlier players start at Slayer level 1.
# PROGRESSION_MODE=stub
# Only with PROGRESSION_MODE=stub: comma-separated account ids that get real progression anyway.
# PROGRESSION_REAL_ACCOUNTS=UID-...,UID-...
# Most XP one request may add to one track. Default 5000.
# PROGRESSION_GRANT_CAP=5000
# off: the rank-confirm route answers 404 again, as upstream did (diagnostic). Default on.
# PROGRESSION_CONFIRM=off
# 1: game servers may reset a progression track. Default off (only an admin key can).
# PROGRESSION_ALLOW_DELETE=1
# Entitlements every real-progression account owns. Empty means none.
# Default season09b_premium,season_premium_any,season_free_any (the Elite Hunt Pass for everyone).
# ENTITLEMENTS_DEFAULT=season09b_premium,season_premium_any,season_free_any
# A game server's XP grant repeated byte for byte less than this many seconds later is answered, not
# added again (a retry). Default 5; 0 turns the guard off. Keep it under 10: the game server sends its
# queued grants at most once every 10 seconds, and two of those can be identical.
# PROGRESSION_REPLAY_WINDOW_S=5
# on: a rank confirm also grants that rank's permanent entitlements from the progression config
# (never items or currencies: the game server pays those). Default off.
# PROGRESSION_CONFIRM_ENTITLEMENTS=on
# A folder of .json season or track files that replace or add progression tracks. Checked at start:
# a bad file stops the metagame. Default: unset (the bundled vendor/progression_config.json).
# PROGRESSION_CONFIG_DIR=C:/dr/dev/seasons
# The Hunt Pass an account has until one is stored. Must be a loaded track. Default season09b.
# ACTIVE_HUNT_PASS=season09b
# off: /balance and /reconcile answer the old fixed sheet instead of the currencies the character
# holds. Default on.
# BALANCE_FROM_INVENTORY=off

# ------------------------------------------------------------------ Escalation and the store

# real: players in real progression keep their own Escalation level, talents and rewards. Default
# stub (upstream's fake maximum, nothing saved). Switching to real drops every player to level 0.
# ESCALATION_MODE=real
# on: with ESCALATION_MODE=real, a save that breaks a soft rule is refused (409) instead of logged.
# Default off.
# ESCALATION_STRICT=on
# free: the in-game store with free cosmetics. Default off (the store screen gets an error, as before).
# STORE=free
# on: with STORE=free, also sell the 20 premium bounty-token bundle, any number of times. Default off.
# STORE_REPEATABLE_TOKENS=on
# Lady Luck's priced Steel/Gilded Marks catalogue through the store purchase service.
# Independent of STORE. Default on; off hides it.
# TRIALS_STORE=off
# on: advertise the current Normal/Dauntless Trial hunts in /game_tuning/seasonal_event_schedule.
# Experimental replacement for the expired client schedule; independent of TRIALS_LEADERBOARDS.
# TRIALS_SCHEDULE=on
# The Middleman exchange-slot offers and weekly Aetherdust cell offers.
# Independent of STORE. Default on; off hides them.
# MIDDLEMAN_STORE=off

# ------------------------------------------------------------------ saves and inventory

# Newest versions of each character and its loadouts kept for rollbacks. Default 100 (at least 2).
# SAVE_HISTORY_KEEP=100
# Then the last version of each hour for this many hours. Default 48; 0 turns this tier off.
# SAVE_HISTORY_HOURLY=48
# And the last version of each day for this many days. Default 30; 0 turns this tier off.
# SAVE_HISTORY_DAILY=30
# 1: refuse (409) an inventory transaction that removes more than the player has. Default off
# (unproven: a refusal drops the whole transaction, rewards included).
# INVENTORY_REFUSE_OVERSPEND=1
# Inventory replies list every stack a transaction touched. Default on; 0 brings back upstream's
# free-upgrade bug.
# INVENTORY_REPORT_REMOVALS=0
# Daily tokens: the game server's daily grants are topped up so the stack lands on these
# (existing characters are set to these once, on the first start of this version).
# PATROL_BONUS_DAILY=10
# BOUNTY_TOKENS_DAILY=6

# ------------------------------------------------------------------ compatibility switches

# Answer the friends list, block list and other routes that were 404 upstream. Default on; 0 = 404.
# MISC_ROUTES=0
# Real usernames in account and party replies. Default on; 0 = upstream's empty {}.
# ACCOUNT_DISPLAY_NAME=0
# 1: answer the client's matchmaking cancel. Default off (experimental: hunts start only because
# the cancel sent after every queued join gets a 404).
# MATCHMAKING_CANCEL=1

# ------------------------------------------------------------------ friends, parties and guilds

# Account lookups for other players (/account/mapping). Default on; 0 maps nothing, as before
# (Add Friends and name-based invites then do nothing in game).
# ACCOUNT_MAPPING=0
# 1: /accountinfo/public answers with the caller's own id again, as upstream did (party invites
# and other players' names then stop showing in game). Default off.
# ACCOUNTINFO_PUBLIC_LEGACY=1
# Guilds. Default on; 0 brings back the old stubs (nobody can create or join a guild).
# GUILDS=0
# Members per guild. Default 100.
# GUILD_MAX_MEMBERS=100
# Days a guild invite stays open. Default 7.
# GUILD_INVITE_TTL_DAYS=7
# Extra words refused in guild names and nameplates, comma-separated (a short list is built in).
# GUILD_NAME_DENYLIST=
# 0: allow the built-in staff and project words in guild names and nameplates (admin, moderator,
# official, GM, DEV, ...). Default on. Short offensive tags stay refused.
# GUILD_RESERVED_NAMES=0
# 1: also accept a guild create when the leader did not validate that exact name, if they validated
# another one or were heard from in the last minute. Default off; only if the live test shows the
# client never validates the final name (the log then says "no validate of this name").
# GUILD_CREATE_ACTIVITY_FALLBACK=1
# 0: a player alone in their party gets a plain party reply instead of the old placeholder
# candidate. Default on (the placeholder); set 0 if Invite to Party does nothing for a solo leader.
# PARTY_SOLO_STUB=0
# off: every /slayerlink route answers 404 again (the stored invites and links stay). Default on.
# SLAYER_LINKS=off
# on: /account/api/oauth/verify answers the old placeholder account to everyone, instead of the
# account of the caller's token. A rollback only. Default off.
# VERIFY_STUB_ACCOUNT=on

# ------------------------------------------------------------------ text chat

# The game's chat connection (XMPP over WebSocket, roadmap 3.10), on by default.
# In public mode the gateway forwards chat to 127.0.0.1:CHAT_PORT; on one PC
# the game connects to it straight. A bad setting or a port in use logs one error line and the
# metagame runs without chat.
# Chat now defaults on when unset/empty. Set 0 to opt out; existing CHAT=0 is preserved on update.
# CHAT=0
# CHAT_PORT=61099
# 127.0.0.1 or ::1; in public mode (GATEWAY_SECRET set) only 127.0.0.1.
# CHAT_BIND_HOST=127.0.0.1
# log: admit a room nickname that fails the name rules, with a warning, instead of refusing the join.
# A rollback switch only, for a real client being refused (docs/findings/chat.md). Default enforce.
# CHAT_NICK_CHECK=log
# 1: log every chat frame, with logins, message text and tokens redacted. First live runs only.
# CHAT_TRACE=1
# on (with CHAT=1): friends' online status. Each player's presence goes to their online friends,
# never back to the player's own account. Default off until the two-player party test passes.
# CHAT_PRESENCE=on

# Optional aggregate backend health for the private owner dashboard. Default off.
# No request URLs, bodies or player identifiers are stored. Restart after changing.
# BACKEND_HEALTH=1

# Optional automatic region latency probes advertised to authenticated launchers.
# Use a reachable TCP listener on each actual regional game host (e.g. its gateway).
# The launcher opens a TCP connection only: no key or request is sent to probes.
# Omitted Main uses the invite host/port; unavailable probes are ignored.
# Australia/Germany are advertised only when AUS_REGION/GERMANY_REGION=1.
# REGION_MAIN_PROBE_HOST=main.example.com
# REGION_MAIN_PROBE_PORT=443
# REGION_AUS_PROBE_HOST=oce.example.com
# REGION_AUS_PROBE_PORT=443
# REGION_GER_PROBE_HOST=de.example.com
# REGION_GER_PROBE_PORT=443

# Optional encrypted owner account-key recovery after successful launcher sign-in.
ACCOUNT_KEY_RECOVERY=0

# Optional key-recovery service secret; direct loopback only. Keep unset until reviewed.
KEY_RECOVERY_SERVICE_SECRET=
