# Dauntless Revived deploy server settings.
# Copy this file to .env in this folder and fill in the empty values.
# npm start and npm run dev read .env (Node refuses to start without it). Variables already set in
# your shell win over the file. Restart the deploy server after any change.
#
# The values below are for development on one PC. Lines starting with # show the default; leave
# them out to get it. Nothing is checked at startup: a missing value only makes launches fail later.
# docs/reference/configuration.md explains every line.
# .env holds the game-server key: never share it, never commit it (it is git-ignored).

# HTTP port; the metagame's DEPLOYSERVER_URL points here. Required: unset stops the deploy server.
PORT=61001
# Listen address. Default 127.0.0.1. Keep it: there is no authentication.
BIND_HOST=127.0.0.1
# The IPv4 address players reach the game servers on. Required, no default.
# 127.0.0.1 on one PC; the Tailscale 100.x address in private mode; the public IPv4 in public mode.
MY_IP=127.0.0.1
# Lowest game-server UDP port. Hunts use PORT_RANGE_BEGIN up to PORT_RANGE_END - 2. Required.
PORT_RANGE_BEGIN=8770
# Ramsgate runs on this port and the Training Dojo on the one below. Required. Keep 8777: the
# server DLL turns its idle shutdown off for ports 8776 and up.
PORT_RANGE_END=8777
# Full path of the 1.4.4 Dauntless-Win64-Shipping.exe, forward slashes, with dxgi.dll and
# UndauntedInternalServer.dll next to it. Required, no default. For example:
#   C:/D144/Dauntless/Archon/Binaries/Win64/Dauntless-Win64-Shipping.exe
GAMESERVER_BINARY_PATH=
# SECRET: never share, never commit. The game-server key, passed to every game server and
# registered in the metagame's database. Required, no default. Generate 48 hex characters with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# and register it as docs/setup/host.md (step 9) shows.
METAGAME_API_KEY=
# Minimum gap between two game-server launches, in seconds. Unset: effectively no gap.
SECONDS_TO_WAIT_BETWEEN_GAMESERVER_STARTUP=10
# 1 starts the Training Dojo at boot, as upstream did. Default: on first use.
# ENABLE_DOJO=1
# 0: hand out Ramsgate and the Dojo without checking that their process is alive, and leave the
# restart to the watchdog (within a minute). Default on: a dead one is started again first.
# PERSISTENT_WORLD_LIVENESS=0
# fatal, error, warn, info, debug, trace or silent. Default info.
# LOG_LEVEL=info
# production: JSON log lines and no stack traces. Default: unset (readable coloured logs).
# NODE_ENV=production

# Memory admission before EVERY new game process (including Ramsgate/Dojo). Default on.
# Keep this much physical RAM free, plus the estimated startup allowance below (MiB).
# GAMESERVER_MIN_FREE_MB=3072
# GAMESERVER_STARTUP_MB=1536
# Optional measured estimate for hunts/tutorials only; defaults to GAMESERVER_STARTUP_MB.
# Does not lower the free-memory floor or the Ramsgate/Dojo estimate.
# GAMESERVER_HUNT_STARTUP_MB=1024
# Reserve the allowance for this many seconds so simultaneous starts cannot oversubscribe RAM.
# GAMESERVER_RESERVATION_SECONDS=60
# Emergency rollback only; existing processes are never stopped by this guard.
# GAMESERVER_MEMORY_GUARD=0

# Optional second deploy server, reached ONLY through a private loopback tunnel.
# New ISLAND hunts spill over once this many local hunts/tutorials are running/starting.
# Explicit capacity refusal can fall back; ambiguous launch timeouts never start duplicates.
# OVERFLOW_DEPLOYSERVER_URL=http://127.0.0.1:61011
# OVERFLOW_AFTER_HUNTS=4
# On the worker only: skip persistent worlds. Leave OVERFLOW_DEPLOYSERVER_URL unset there.
# HUNT_WORKER=1
# Worker hunt ports MUST be below 8776: the native DLL disables idle shutdown above that.

# Retire nonpersistent hunts after two hours, or ten minutes of fresh zero-player telemetry.
# Missing/stale telemetry does not count as empty. Ramsgate and Dojo are exempt.
HUNT_MAX_AGE_MINUTES=120
HUNT_EMPTY_MINUTES=10
# Optional Australia worker, through a private loopback tunnel only.
# AUS_DEPLOYSERVER_URL=http://127.0.0.1:61021

# Ramsgate cities start only when requested, with 20 seats each. Additional cities
# share the hunt port pool and memory admission; Dojo's port remains reserved.
# Requires the rebuilt pool-aware server DLL. 0 restores the permanent legacy city.
RAMSGATE_POOL=1

# Set on a retired database/backup host to refuse all native game launches.
# Also disable its scheduled deploy task and remove upstream worker URLs.
SERVER_ROLE=game
